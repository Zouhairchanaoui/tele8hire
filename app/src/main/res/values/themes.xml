<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tele8Hire" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Tele8Hire.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/teal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Tele8Hire</item>
    </style>
</resources>
